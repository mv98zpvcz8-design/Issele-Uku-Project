# Copy this file to .env.local for local development. Never commit
# .env.local or any file containing real secrets — .env* is already
# git-ignored.
#
# None of these are required to run Phase 1 (the site builds and runs with
# no environment variables set). They are documented here ahead of Phase 2
# so the shape is visible early. See DEPLOYMENT.md for which of these need
# to be added in the Vercel dashboard, and for which environments
# (Development / Preview / Production).

# --- Site ---
# Public base URL of this deployment. Safe to expose (NEXT_PUBLIC_ prefix).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to "true" only after a deliberate decision to let search engines
# index this deployment (see DECISIONS.md). Leave unset/false on Preview
# and on Production until the site is ready to be publicly promoted.
NEXT_PUBLIC_ALLOW_SEARCH_INDEXING=false

# --- Supabase (introduced in Phase 2 — not required yet) ---
# Project URL and anon (public) key. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key. SERVER-SIDE ONLY. Never prefix with NEXT_PUBLIC_, never
# send to the browser, never log it. Used only in server components/route
# handlers/admin actions that must bypass Row Level Security intentionally
# (e.g. an admin publishing action after checking the user's role).
SUPABASE_SERVICE_ROLE_KEY=
